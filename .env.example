# =============================================
# ENVIRONMENT VARIABLES
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================
# SUPABASE CONFIGURATION (Required)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# =============================================

# Supabase Project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
PUBLIC_SUPABASE_URL=

# Supabase Anonymous Key (safe for browser/public use)
PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (NEVER expose to client - server-side only)
# Used for admin operations like storing contact form messages
SUPABASE_SERVICE_ROLE_KEY=

# =============================================
# CLOUDFLARE TURNSTILE (Optional but recommended)
# Get these from: https://dash.cloudflare.com/?to=/:account/turnstile
# =============================================

# Turnstile Site Key (public, used in frontend widget)
PUBLIC_TURNSTILE_SITE_KEY=

# Turnstile Secret Key (server-side verification)
TURNSTILE_SECRET_KEY=

# =============================================
# CONTACT FORM (Optional)
# =============================================

# Email address to receive contact form notifications
CONTACT_EMAIL=

# =============================================
# PRODUCTION NOTES
# =============================================
# 
# For Vercel deployment, add these as Environment Variables:
# 1. Go to Vercel Dashboard > Project > Settings > Environment Variables
# 2. Add each variable with appropriate values
# 3. Mark sensitive values (SERVICE_ROLE_KEY, TURNSTILE_SECRET) as "Sensitive"
#
# For local development:
# 1. Copy this file to .env
# 2. Fill in your development/test values
# 3. Run `npm run dev`
