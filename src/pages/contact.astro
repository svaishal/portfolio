---
import Layout from '../layouts/Layout.astro';
import { getPortfolioData, getSocialUrl } from '../lib/data';

// Fetch portfolio data
const data = await getPortfolioData();
const profile = data.profile;
const githubUrl = getSocialUrl(data.socialLinks, 'github');
const linkedinUrl = getSocialUrl(data.socialLinks, 'linkedin');
---

{profile ? (
<Layout
  title="Contact"
  description="Get in touch for opportunities, collaborations, or technical discussions"
  profileData={data}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 px-6 relative overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 left-1/4 w-125 h-125 bg-primary/10 rounded-full blur-[100px] animate-pulse"></div>
      <div class="absolute bottom-0 right-1/4 w-100 h-100 bg-blue-900/10 rounded-full blur-[80px] animate-pulse" style="animation-delay: 1s;"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <div class="opacity-0 animate-fade-in-up">
        <p class="section-title">Get in Touch</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
          Let's Connect
        </h1>
        <p class="text-xl text-text-muted max-w-2xl mx-auto font-light leading-relaxed">
          Have a question or want to discuss opportunities? I'd love to hear from you. I typically respond within 24 hours.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid lg:grid-cols-5 gap-12">
        <!-- Contact Form -->
        <div class="lg:col-span-3" data-animate>
          <div class="glass-card p-8 md:p-10">
            <h2 class="text-2xl font-bold text-white mb-8">Send a Message</h2>
            
            <form
              class="space-y-6"
              id="contact-form"
            >
              <!-- Error Message (hidden by default) -->
              <div id="error-message" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span></span>
              </div>

              <div class="grid sm:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-sm font-medium text-text-muted mb-2">
                    Name <span class="text-primary">*</span>
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    maxlength="100"
                    class="w-full px-4 py-3 bg-surface border border-white/10 rounded-xl focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-white placeholder-text-dim"
                    placeholder="Your name"
                  />
                </div>

                <div>
                  <label for="email" class="block text-sm font-medium text-text-muted mb-2">
                    Email <span class="text-primary">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    maxlength="320"
                    class="w-full px-4 py-3 bg-surface border border-white/10 rounded-xl focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-white placeholder-text-dim"
                    placeholder="your.email@example.com"
                  />
                </div>
              </div>

              <div>
                <label for="subject" class="block text-sm font-medium text-text-muted mb-2">
                  Subject <span class="text-primary">*</span>
                </label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  required
                  maxlength="200"
                  class="w-full px-4 py-3 bg-surface border border-white/10 rounded-xl focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-white placeholder-text-dim"
                  placeholder="What would you like to discuss?"
                />
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-text-muted mb-2">
                  Message <span class="text-primary">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  maxlength="5000"
                  class="w-full px-4 py-3 bg-surface border border-white/10 rounded-xl focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all resize-none text-white placeholder-text-dim"
                  placeholder="Tell me more about your inquiry..."
                ></textarea>
              </div>

              <!-- Honeypot field for spam protection (hidden) -->
              <div style="position: absolute; left: -9999px;" aria-hidden="true">
                <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
              </div>

              <!-- Cloudflare Turnstile widget -->
              <div id="turnstile-container" class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || ''} data-theme="dark"></div>

              <button
                type="submit"
                id="submit-button"
                class="w-full btn-primary py-4 text-lg disabled:opacity-50 disabled:cursor-not-allowed group"
              >
                <span id="submit-text" class="flex items-center justify-center gap-2">
                  Send Message
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
                <span id="submit-loading" class="hidden flex items-center justify-center gap-2">
                  <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                  </svg>
                  Sending...
                </span>
              </button>
            </form>

            <!-- Success Message (hidden by default) -->
            <div id="success-message" class="hidden text-center py-12 animate-fade-in">
              <div class="w-20 h-20 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mx-auto mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-white mb-2">Message Sent!</h3>
              <p class="text-text-muted mb-8">Thank you for reaching out. I'll get back to you soon.</p>
              <button 
                onclick="window.location.reload()" 
                class="btn-secondary"
              >
                Send Another Message
              </button>
            </div>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="lg:col-span-2 space-y-6" data-animate>
          <!-- Info Card -->
          <div class="glass-card p-8">
            <h2 class="text-xl font-bold text-white mb-6">Contact Info</h2>
            
            <div class="space-y-6">
              <!-- Location -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-white font-medium mb-1">Location</h3>
                  <p class="text-text-muted">{profile.location}</p>
                </div>
              </div>

              <!-- Response Time -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-white font-medium mb-1">Response Time</h3>
                  <p class="text-text-muted">Within 24 hours</p>
                </div>
              </div>

              <!-- Availability -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-white font-medium mb-1">Availability</h3>
                  <p class="text-text-muted">{profile.open_to_work ? 'Open to opportunities' : 'Not currently looking'}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="glass-card p-8">
            <h2 class="text-xl font-bold text-white mb-6">Connect With Me</h2>
            
            <div class="space-y-4">
              <a
                href={linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-4 p-4 bg-surface border border-white/5 rounded-xl hover:border-primary/50 hover:bg-white/5 transition-all group"
              >
                <div class="w-10 h-10 rounded-lg bg-[#0077b5]/20 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#0077b5]" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <p class="text-white font-medium group-hover:text-primary transition-colors">LinkedIn</p>
                  <p class="text-text-muted text-sm">Connect professionally</p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-text-dim group-hover:text-primary group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-4 p-4 bg-surface border border-white/5 rounded-xl hover:border-primary/50 hover:bg-white/5 transition-all group"
              >
                <div class="w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <p class="text-white font-medium group-hover:text-primary transition-colors">GitHub</p>
                  <p class="text-text-muted text-sm">Check out my code</p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-text-dim group-hover:text-primary group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Availability Badge -->
          {profile.open_to_work && (
            <div class="glass-card p-6 bg-gradient-to-br from-emerald-500/10 to-teal-500/10 border-emerald-500/20">
              <div class="flex items-center gap-4">
                <div class="relative">
                  <span class="flex h-4 w-4">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-4 w-4 bg-emerald-500"></span>
                  </span>
                </div>
                <div>
                  <p class="text-white font-medium">Currently Available</p>
                  <p class="text-text-muted text-sm">Open for new opportunities</p>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12" data-animate>
        <p class="section-title">FAQ</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Common Questions</h2>
      </div>

      <div class="space-y-4" data-animate>
        <div class="glass-card p-6 hover:border-primary/30 transition-all">
          <h3 class="text-lg font-bold text-white mb-2">What type of roles are you looking for?</h3>
          <p class="text-text-muted">I'm interested in Technical Support, IT Infrastructure, or Help Desk roles where I can leverage my experience in enterprise support and customer service.</p>
        </div>

        <div class="glass-card p-6 hover:border-primary/30 transition-all">
          <h3 class="text-lg font-bold text-white mb-2">Are you open to remote work?</h3>
          <p class="text-text-muted">Yes, I'm comfortable with remote, hybrid, or on-site arrangements. My experience includes supporting remote teams and working across different time zones.</p>
        </div>

        <div class="glass-card p-6 hover:border-primary/30 transition-all">
          <h3 class="text-lg font-bold text-white mb-2">What's your notice period?</h3>
          <p class="text-text-muted">Please reach out to discuss availability and timeline. I'm flexible and can work with reasonable notice periods.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
) : (
<Layout title="Setup Required">
  <div class="min-h-screen flex items-center justify-center bg-background text-white p-6">
    <div class="text-center max-w-md w-full glass-card p-8">
      <div class="w-16 h-16 bg-primary/20 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold mb-4">Portfolio Setup Required</h1>
      <p class="text-text-muted mb-8">Please log in to the admin dashboard to migrate data.</p>
      <a href="/admin" class="btn-primary w-full justify-center">
        Go to Admin Dashboard
      </a>
    </div>
  </div>
</Layout>
)}

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  // Form submission handling with API endpoint
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text');
  const submitLoading = document.getElementById('submit-loading');

  function showError(message: string) {
    if (errorMessage) {
      errorMessage.querySelector('span')!.textContent = message;
      errorMessage.classList.remove('hidden');
    }
  }

  function hideError() {
    errorMessage?.classList.add('hidden');
  }

  function setLoading(loading: boolean) {
    if (submitButton) submitButton.disabled = loading;
    submitText?.classList.toggle('hidden', loading);
    submitLoading?.classList.toggle('hidden', !loading);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    setLoading(true);
    
    const formData = new FormData(form);
    
    // Get Turnstile token
    const turnstileToken = (window as any).turnstile?.getResponse();
    
    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      subject: formData.get('subject'),
      message: formData.get('message'),
      honeypot: formData.get('honeypot'),
      turnstileToken: turnstileToken || '',
    };
    
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const data = await response.json();

      if (response.ok && data.success) {
        form.style.display = 'none';
        successMessage?.classList.remove('hidden');
      } else {
        showError(data.error || 'Failed to send message. Please try again.');
        // Reset Turnstile
        (window as any).turnstile?.reset();
      }
    } catch (error) {
      console.error('Form submission error:', error);
      showError('Network error. Please check your connection and try again.');
      (window as any).turnstile?.reset();
    } finally {
      setLoading(false);
    }
  });
</script>
