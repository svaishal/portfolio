---
import Layout from '../layouts/Layout.astro';
import { useProfileData } from '../hooks/useProfileData';
import ToolsGrid from '../components/ToolsGrid.astro';

// Fetch portfolio data (Supabase or fallback to local JSON)
const data = await useProfileData();
const profile = data.profile;
---

{profile ? (
<Layout
  title="Portfolio"
  description="Featured projects and case studies showcasing IT solutions and technical expertise"
  profileData={data}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 px-6 relative overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[100px] animate-pulse"></div>
      <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] bg-indigo-900/10 rounded-full blur-[80px] animate-pulse" style="animation-delay: 1s;"></div>
    </div>

    <!-- Grid Pattern -->


    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <div class="opacity-0 animate-fade-in-up">
        <p class="section-title">My Work</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
          Portfolio
        </h1>
        <p class="text-xl text-text-muted max-w-2xl mx-auto font-light leading-relaxed">
          A collection of projects and initiatives that showcase my problem-solving approach and technical capabilities.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects Bento Grid -->
  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {data.projects.map((project: any, index: number) => (
          <div 
            class={`glass-card p-8 group hover:border-primary/30 transition-all duration-500 hover:-translate-y-2 relative overflow-hidden flex flex-col h-full ${index === 0 ? 'lg:col-span-2' : ''}`}
            data-animate
          >
            <!-- Background Glow on Hover -->
            <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
            
            <!-- Icon -->
            <div class="relative z-10 flex flex-col h-full">
              <div class="flex items-start justify-between mb-8">
                <span class="text-5xl p-3 bg-white/5 rounded-2xl">{project.icon}</span>
                <span class="px-3 py-1 text-xs font-medium border border-white/10 rounded-full bg-surface/50 text-text-dim">{project.category}</span>
              </div>
              
              <!-- Title & Description -->
              <div class="mb-auto">
                <h3 class="text-2xl font-bold text-white mb-4 group-hover:text-primary transition-colors">
                  {project.title}
                </h3>
                <p class="text-text-muted leading-relaxed mb-6 text-sm">
                  {project.description}
                </p>
              </div>
              
              <!-- Highlights -->
              <div class="flex flex-wrap gap-2 mb-8">
                {project.highlights.map((highlight: string) => (
                  <span class="px-3 py-1 text-xs bg-white/5 border border-white/10 text-text-dim rounded-full">
                    {highlight}
                  </span>
                ))}
              </div>
              
              <!-- Impact -->
              <div class="flex items-center gap-2 pt-6 border-t border-white/5 mt-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                <span class="text-emerald-400 font-semibold text-sm">{project.impact}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach Section -->
  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16" data-animate>
        <p class="section-title">Methodology</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">My Approach</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6" data-animate>
        <div class="glass-card p-8 text-center hover:border-primary/30 transition-all duration-300 group hover:-translate-y-1">
          <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Analyze</h3>
          <p class="text-text-muted text-sm leading-relaxed">Deep dive into the problem to understand root causes and context.</p>
        </div>

        <div class="glass-card p-8 text-center hover:border-primary/30 transition-all duration-300 group hover:-translate-y-1">
          <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Solve</h3>
          <p class="text-text-muted text-sm leading-relaxed">Design and implement effective solutions with clear documentation.</p>
        </div>

        <div class="glass-card p-8 text-center hover:border-emerald-500/30 transition-all duration-300 group hover:-translate-y-1">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Iterate</h3>
          <p class="text-text-muted text-sm leading-relaxed">Continuously improve based on feedback and outcomes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Metrics -->
  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="glass-card p-12 bg-surface/50 border-white/5" data-animate>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <p class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary to-white mb-2">99.5%</p>
            <p class="text-text-muted text-sm uppercase tracking-wider font-medium">Uptime Achieved</p>
          </div>
          <div>
            <p class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary to-white mb-2">30%</p>
            <p class="text-text-muted text-sm uppercase tracking-wider font-medium">Faster Response</p>
          </div>
          <div>
            <p class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary to-white mb-2">40%</p>
            <p class="text-text-muted text-sm uppercase tracking-wider font-medium">Fewer Tickets</p>
          </div>
          <div>
            <p class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary to-white mb-2">95%+</p>
            <p class="text-text-muted text-sm uppercase tracking-wider font-medium">Satisfaction</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools & Technologies -->
  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16" data-animate>
        <p class="section-title">Tech Stack</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Tools I Work With</h2>
      </div>

      <div data-animate>
        <ToolsGrid />
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto text-center" data-animate>
      <div class="glass-card p-12 bg-surface/50 relative overflow-hidden">
        <div class="absolute inset-0 bg-primary/5 pointer-events-none"></div>
        <div class="relative z-10">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Have a Project in Mind?</h2>
          <p class="text-text-muted mb-10 max-w-lg mx-auto text-lg leading-relaxed">
            I'm always interested in hearing about new challenges and opportunities to make technology work better for people.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="btn-primary group">
              <span>Let's Talk</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </a>
            <a href="/experience" class="btn-secondary">
              <span>View Experience</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
) : (
<Layout title="Setup Required">
  <div class="min-h-screen flex items-center justify-center bg-background text-white p-6">
    <div class="text-center max-w-md w-full glass-card p-8">
      <div class="w-16 h-16 bg-primary/20 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold mb-4">Portfolio Setup Required</h1>
      <p class="text-text-muted mb-8">Please log in to the admin dashboard to migrate data.</p>
      <a href="/admin" class="btn-primary w-full justify-center">
        Go to Admin Dashboard
      </a>
    </div>
  </div>
</Layout>
)}
