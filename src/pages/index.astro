---
import Layout from '../layouts/Layout.astro';
import { getPortfolioData, getSocialUrl, getInitials } from '../lib/data';

// Fetch portfolio data (Supabase or fallback to local JSON)
const data = await getPortfolioData();
const profile = data.profile!;
const githubUrl = getSocialUrl(data.socialLinks, 'github');
const linkedinUrl = getSocialUrl(data.socialLinks, 'linkedin');
---

<Layout
  title="Home"
  description={profile.tagline}
>
  <!-- Hero Section -->
  <section class="min-h-screen flex items-center justify-center px-6 pt-20 pb-16 relative overflow-hidden">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-slate-500/5 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-slate-600/5 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-slate-700/5 rounded-full blur-3xl"></div>
    </div>

    <!-- Grid Pattern -->
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"></div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <!-- Status Badge -->
      <div class="opacity-0 animate-fade-in-down flex justify-center mb-8">
        {profile.open_to_work && (
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-emerald-400 text-sm font-medium">Open to Work</span>
          </div>
        )}
      </div>

      <!-- Profile Image -->
      <div class="opacity-0 animate-scale-in delay-100 mb-8 flex justify-center">
        <div class="relative">
          <div class="w-32 h-32 rounded-2xl bg-accent p-1 shadow-2xl shadow-black/30">
            <div class="w-full h-full rounded-2xl bg-[#12121a] flex items-center justify-center overflow-hidden">
              {profile.profile_photo_url ? (
                <img src={profile.profile_photo_url} alt={profile.name} class="w-full h-full object-cover" />
              ) : (
                <span class="text-5xl font-bold gradient-text-accent">{getInitials(profile.name)}</span>
              )}
            </div>
          </div>
          <div class="absolute -bottom-2 -right-2 w-8 h-8 rounded-lg bg-accent flex items-center justify-center text-white shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Name -->
      <h1 class="opacity-0 animate-fade-in-up delay-200 text-5xl sm:text-6xl lg:text-7xl font-bold mb-4 tracking-tight">
        <span class="text-white">{profile.name}</span>
      </h1>

      <!-- Role -->
      <div class="opacity-0 animate-fade-in-up delay-300 mb-6">
        <p class="text-xl sm:text-2xl lg:text-3xl font-medium gradient-text-accent">
          {profile.role}
        </p>
        <p class="text-slate-400 text-sm sm:text-base mt-2">
          {profile.subtitle}
        </p>
      </div>

      <!-- Location & Experience -->
      <div class="opacity-0 animate-fade-in-up delay-400 flex flex-wrap justify-center gap-4 mb-8">
        <div class="flex items-center gap-2 text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="text-sm">{profile.location}</span>
        </div>
        <div class="w-px h-4 bg-slate-700"></div>
        <div class="flex items-center gap-2 text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="text-sm">{profile.years_experience} Years Experience</span>
        </div>
      </div>

      <!-- Tagline -->
      <p class="opacity-0 animate-fade-in-up delay-500 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        {profile.tagline}
      </p>

      <!-- CTA Buttons -->
      <div class="opacity-0 animate-fade-in-up delay-600 flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a href="/portfolio" class="btn-primary">
          <span>View My Work</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="/contact" class="btn-secondary">
          <span>Get in Touch</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </a>
      </div>

      <!-- Social Links -->
      <div class="opacity-0 animate-fade-in-up delay-700 flex justify-center gap-4">
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/10 hover:border-accent/50 transition-all duration-300 hover:scale-110"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/10 hover:border-accent/50 transition-all duration-300 hover:scale-110"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0 animate-fade-in delay-800">
      <a href="#skills" class="flex flex-col items-center gap-2 text-slate-500 hover:text-slate-300 transition-colors">
        <span class="text-xs uppercase tracking-widest">Scroll</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Skills Preview Section -->
  <section id="skills" class="py-20 px-6 relative">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12" data-animate>
        <p class="section-title">What I Do</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Core Expertise</h2>
        <p class="text-slate-400 max-w-2xl mx-auto">Bridging the gap between technology and users with reliable support and clear communication.</p>
      </div>

      <!-- Skills Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4" data-animate>
        {data.technicalSkills.slice(0, 8).map((skill, index: number) => (
          <div 
            class="glass-card p-4 text-center hover:border-accent/30 transition-all duration-300 hover:-translate-y-1 group"
            style={`animation-delay: ${index * 50}ms`}
          >
            <p class="text-slate-300 text-sm font-medium group-hover:text-white transition-colors">{skill.name}</p>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="text-center mt-12" data-animate>
        <a href="/experience" class="inline-flex items-center gap-2 text-accent hover:text-accent/80 transition-colors group">
          <span>View Full Experience</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="py-20 px-6 relative">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6" data-animate>
        <div class="glass-card p-6 text-center">
          <p class="text-4xl font-bold gradient-text-accent mb-2">{profile.years_experience}+</p>
          <p class="text-slate-400 text-sm">Years Experience</p>
        </div>
        <div class="glass-card p-6 text-center">
          <p class="text-4xl font-bold gradient-text-accent mb-2">{data.experiences.length}</p>
          <p class="text-slate-400 text-sm">Roles</p>
        </div>
        <div class="glass-card p-6 text-center">
          <p class="text-4xl font-bold gradient-text-accent mb-2">95%+</p>
          <p class="text-slate-400 text-sm">Satisfaction Rate</p>
        </div>
        <div class="glass-card p-6 text-center">
          <p class="text-4xl font-bold gradient-text-accent mb-2">{data.certifications.length}</p>
          <p class="text-slate-400 text-sm">Certifications</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Experience -->
  <section class="py-20 px-6 relative">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12" data-animate>
        <p class="section-title">Career Journey</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">My Path</h2>
      </div>

      <!-- Timeline Preview -->
      <div class="space-y-6" data-animate>
        {data.experiences.map((exp, index: number) => (
          <div class="glass-card p-6 hover:border-accent/30 transition-all duration-300 group">
            <div class="flex items-start gap-4">
              <div class="text-3xl">{exp.icon}</div>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 mb-2">
                  <h3 class="text-lg font-semibold text-white group-hover:text-accent transition-colors">{exp.role}</h3>
                  {exp.is_current && (
                    <span class="badge-success text-xs">Current</span>
                  )}
                </div>
                <p class="text-slate-400 text-sm mb-2">{exp.company} • {exp.period}</p>
                <p class="text-slate-300 text-sm">{exp.achievements[0]}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-8" data-animate>
        <a href="/experience" class="btn-secondary">
          <span>Full Experience</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 px-6 relative">
    <div class="max-w-4xl mx-auto">
      <div class="glass-card p-8 sm:p-12 text-center relative overflow-hidden" data-animate>
        <!-- Background Gradient -->
        <div class="absolute inset-0 bg-accent/5 pointer-events-none"></div>
        
        <div class="relative z-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Let's Work Together</h2>
          <p class="text-slate-400 mb-8 max-w-lg mx-auto">
            Looking for a reliable IT professional who communicates clearly and delivers results? Let's connect.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="btn-primary">
              <span>Get in Touch</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
            <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
              <span>LinkedIn</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
