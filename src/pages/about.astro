---
import Layout from '../layouts/Layout.astro';
import { getInitials } from '../lib/data';
import { useProfileData } from '../hooks/useProfileData';

import CertificationCard from '../components/CertificationCard.astro';
import StatsCard from '../components/StatsCard.astro';

// Fetch portfolio data
const data = await useProfileData();
const profile = data.profile;

// Enable Edge Caching (Hyperscale Fix P0)
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=3600, stale-while-revalidate=86400'
);
---

{profile ? (
<Layout
  title="About"
  description="Learn about my journey from ERP systems to enterprise IT support"
  profileData={data}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 px-6 relative overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 right-0 w-125 h-125 bg-primary/10 rounded-full blur-[100px] animate-pulse"></div>
      <div class="absolute bottom-0 left-0 w-100 h-100 bg-indigo-900/10 rounded-full blur-[80px] animate-pulse" style="animation-delay: 1s;"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto">
      <div class="text-center mb-12 opacity-0 animate-fade-in-up">
        <p class="section-title">About Me</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
          My Story
        </h1>
        <p class="text-xl text-text-muted max-w-2xl mx-auto font-light leading-relaxed">
          {profile.about_intro}
        </p>
      </div>

      <!-- Profile Card -->
      <div class="glass-card p-8 md:p-10 flex flex-col md:flex-row items-center gap-10 opacity-0 animate-fade-in-up delay-200">
        <!-- Avatar -->
        <div class="shrink-0 relative group">
          <div class="absolute inset-0 bg-primary/20 blur-xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="w-48 h-48 rounded-2xl bg-surface border border-white/10 p-1 shadow-2xl relative z-10">
            <div class="w-full h-full rounded-xl bg-surface flex items-center justify-center overflow-hidden">
              {profile.profile_photo_url ? (
                <img src={profile.profile_photo_url} alt={profile.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              ) : (
                <span class="text-6xl font-bold text-transparent bg-clip-text bg-linear-to-br from-white to-text-muted">{getInitials(profile.name)}</span>
              )}
            </div>
          </div>
        </div>

        <!-- Info -->
        <div class="flex-1 text-center md:text-left">
          <h2 class="text-3xl font-bold text-white mb-2">{profile.name}</h2>
          <p class="text-primary font-medium text-lg mb-6">{profile.role}</p>
          <p class="text-text-muted leading-relaxed text-lg mb-8 font-light">{profile.bio.split('\n\n')[0]}</p>
          
          <div class="flex flex-wrap gap-4 mt-6 justify-center md:justify-start">
            <div class="flex items-center gap-2 text-text-dim px-4 py-2 rounded-full bg-surface/50 border border-white/5 backdrop-blur-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="text-sm font-medium">{profile.location}</span>
            </div>
            <div class="flex items-center gap-2 text-text-dim px-4 py-2 rounded-full bg-surface/50 border border-white/5 backdrop-blur-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="text-sm font-medium">{profile.years_experience}+ Years</span>
            </div>
            {profile.open_to_work && (
              <div class="px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-medium">
                Open to Work
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Journey Section -->
  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16" data-animate>
        <p class="section-title">Career Journey</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">The Path I've Walked</h2>
      </div>

      <div class="space-y-8">
        {data.journeyPhases.map((phase) => (
          <div class="glass-card p-8 relative group hover:border-primary/30 transition-all duration-300" data-animate>
            <!-- Left accent bar -->
            <div class="absolute left-0 top-0 bottom-0 w-1 bg-linear-to-b from-primary to-transparent opacity-50 rounded-l-2xl group-hover:opacity-100 transition-opacity"></div>
            
            <div class="ml-4">
              <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary transition-colors">
                {phase.phase}
              </h3>
              <p class="text-text-muted leading-relaxed">
                {phase.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Values -->
      <div class="glass-card p-10 mt-16 bg-surface/50 border-white/5 text-center relative overflow-hidden" data-animate>
        <div class="absolute inset-0 bg-primary/5 pointer-events-none"></div>
        <div class="relative z-10">
          <h3 class="text-2xl font-bold text-white mb-6">What I Bring</h3>
          <p class="text-text-muted leading-relaxed text-lg max-w-2xl mx-auto font-light">
            {profile.about_values}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="py-20 px-6 relative">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16" data-animate>
        <p class="section-title">Capabilities</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Skills & Expertise</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Technical Skills -->
        <div class="glass-card p-8" data-animate>
          <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white">Technical Skills</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {data.technicalSkills.map((skill) => (
              <span class="px-3 py-2 text-sm bg-surface border border-white/10 text-text-muted rounded-lg hover:border-primary/50 hover:text-white transition-all cursor-default">
                {skill.name}
              </span>
            ))}
          </div>
        </div>

        <!-- Soft Skills -->
        <div class="glass-card p-8" data-animate>
          <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white">Professional Skills</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {data.softSkills.map((skill) => (
              <span class="px-3 py-2 text-sm bg-surface border border-white/10 text-text-muted rounded-lg hover:border-primary/50 hover:text-white transition-all cursor-default">
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>



  <!-- Currently Learning Section -->
  <section class="py-20 px-6 relative">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12" data-animate>
        <p class="section-title">Growth</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-6">Currently Learning</h2>
      </div>

      <div class="glass-card p-12 bg-surface/50 border-white/5" data-animate>
        <StatsCard
          stats={[
            { value: '99.5%', label: 'Uptime Achieved', valueClass: 'text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-linear-to-r from-primary to-white mb-2' },
            { value: '30%', label: 'Faster Response', valueClass: 'text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-linear-to-r from-primary to-white mb-2' },
            { value: '40%', label: 'Fewer Tickets', valueClass: 'text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-linear-to-r from-primary to-white mb-2' },
            { value: '95%+', label: 'Satisfaction', valueClass: 'text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-linear-to-r from-primary to-white mb-2' }
          ]}
        />
      </div>
    </div>
  </section>

  <!-- Education & Certifications -->
  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16" data-animate>
        <p class="section-title">Credentials</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Education & Certifications</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Education -->
        <div class="glass-card p-8" data-animate>
          <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path d="M12 14l9-5-9-5-9 5 9 5z" />
                <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white">Education</h3>
          </div>
          {data.education.map((edu) => (
            <div class="mb-6 last:mb-0 p-4 rounded-xl hover:bg-white/5 transition-colors">
              <h4 class="text-lg font-bold text-white">{edu.degree}</h4>
              <p class="text-primary font-medium">{edu.institution}</p>
              <p class="text-sm text-text-dim mt-1">{edu.field} • {edu.year}</p>
            </div>
          ))}
        </div>

        <!-- Certifications -->
        <div class="glass-card p-8" data-animate>
          <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white">Certifications</h3>
          </div>
          <div class="space-y-3">
            {data.certifications.slice(0, 6).map((cert) => (
              <CertificationCard name={cert.name} icon={cert.icon} variant="horizontal" />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto text-center" data-animate>
      <div class="glass-card p-12 bg-primary/5 relative overflow-hidden">
        <div class="absolute inset-0 bg-linear-to-t from-primary/10 to-transparent pointer-events-none"></div>
        <div class="relative z-10">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Want to Learn More?</h2>
          <p class="text-text-muted mb-10 max-w-lg mx-auto text-lg leading-relaxed">Check out my experience timeline, download my resume, or get in touch directly.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/api/resume" target="_blank" class="btn-primary group">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:-translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Download Resume</span>
            </a>
            <a href="/experience" class="btn-secondary">
              <span>View Experience</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a href="/contact" class="btn-secondary">
              <span>Contact Me</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
) : (
<Layout title="Setup Required">
  <div class="min-h-screen flex items-center justify-center bg-background text-white p-6">
    <div class="text-center max-w-md w-full glass-card p-8">
      <div class="w-16 h-16 bg-primary/20 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold mb-4">Portfolio Setup Required</h1>
      <p class="text-text-muted mb-8">Please log in to the admin dashboard to migrate data.</p>
      <a href="/admin" class="btn-primary w-full justify-center">
        Go to Admin Dashboard
      </a>
    </div>
  </div>
</Layout>
)}
