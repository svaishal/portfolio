---
interface Props {
  name: string;
  description: string;
  status?: string;
}

const { name, description, status = 'in-progress' } = Astro.props;
---

<div 
  class="group relative flex items-center gap-3 p-4 bg-surface border border-white/5 rounded-xl hover:border-primary/50 hover:bg-white/5 transition-all cursor-default"
  tabindex="0"
  role="button"
  aria-describedby={`learn-tooltip-${name.replace(/\s+/g, '-').toLowerCase()}`}
>
  <!-- Status indicator -->
  <div class="relative flex items-center justify-center w-3 h-3">
    <span class="absolute inline-flex h-full w-full rounded-full bg-primary opacity-20 animate-ping"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
  </div>

  <span class="text-sm font-medium text-text-muted group-hover:text-white transition-colors">
    {name}
  </span>
  
  <!-- Tooltip -->
  <div 
    id={`learn-tooltip-${name.replace(/\s+/g, '-').toLowerCase()}`}
    role="tooltip"
    class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-3 bg-surface border border-white/10 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-20 pointer-events-none text-center"
  >
    <span class="text-xs text-text-muted leading-relaxed">{description}</span>
    
    <!-- Arrow -->
    <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-surface"></div>
  </div>
</div>
