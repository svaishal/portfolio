---
interface Tool {
  name: string;
  category: string;
  description: string;
  slug?: string; // Simple Icons slug
  icon?: string; // Custom SVG path if no slug
  imageUrl?: string; // Custom image URL (for multicolour logos)
}

const tools: Tool[] = [
  // Remote / Virtualization
  { name: 'LogMeIn', category: 'Remote Access', description: 'Secure remote access', slug: 'logmein' },
  { name: 'AnyDesk', category: 'Remote Access', description: 'Remote desktop software', slug: 'anydesk' },
  { name: 'Citrix Workspace', category: 'Virtualization', description: 'Digital workspace', slug: 'citrix' },
  { name: 'Uptime Kuma', category: 'Monitoring', description: 'Self-hosted monitoring', slug: 'uptimekuma' },
  { name: 'Docker', category: 'Containerization', description: 'App containerization', slug: 'docker' },
  { name: 'Proxmox', category: 'Virtualization', description: 'Server management', slug: 'proxmox' },
  
  // Virtualization / Admin
  { name: 'VirtualBox', category: 'Virtualization', description: 'Desktop virtualization', slug: 'virtualbox' },
  { name: 'Hyper-V', category: 'Virtualization', description: 'Microsoft virtualization', icon: 'microsoft' },
  { name: 'Okta', category: 'Identity', description: 'Identity management', slug: 'okta' },
  { name: 'Active Directory', category: 'Identity', description: 'Directory services', imageUrl: 'https://www.citypng.com/public/uploads/preview/active-directory-windows-server-logo-image-png-735811697038907r3cnidkiin.png' },
  { name: 'Specops', category: 'Security', description: 'Password management', icon: 'lock' },
  { name: 'Active Roles', category: 'Identity', description: 'AD management', icon: 'user-cog' },

  // Network / Security
  { name: 'Tailscale', category: 'Network', description: 'Secure overlay network', slug: 'tailscale' },
  { name: 'OpenVPN', category: 'Network', description: 'VPN protocol', slug: 'openvpn' },
  { name: 'GlobalProtect', category: 'Security', description: 'Enterprise VPN', slug: 'paloaltonetworks' },
  { name: 'Sophos Firewall', category: 'Security', description: 'Network protection', slug: 'sophos' },
  { name: 'GitHub', category: 'DevOps', description: 'Code collaboration', slug: 'github' },
  { name: 'VS Code', category: 'Development', description: 'Code editor', slug: 'visualstudiocode' },

  // SaaS / Cloud
  { name: 'Cloudflare', category: 'Network', description: 'Web performance', slug: 'cloudflare' },
  { name: 'Brevo', category: 'Marketing', description: 'CRM platform', slug: 'brevo' },
  { name: 'ServiceNow', category: 'ITSM', description: 'Service management', slug: 'servicenow' },
  { name: 'Zendesk', category: 'Support', description: 'Customer service', slug: 'zendesk' },
  { name: 'Snipe-IT', category: 'Asset Mgmt', description: 'Asset management', slug: 'snipeit' },
  { name: 'Google Workspace', category: 'Productivity', description: 'Cloud collaboration', slug: 'google' },

  // Productivity / OS
  { name: 'Microsoft 365', category: 'Productivity', description: 'Office suite', slug: 'microsoft365' },
  { name: 'Slack', category: 'Communication', description: 'Team chat', slug: 'slack' },
  { name: 'HIS ERP', category: 'ERP', description: 'Hospital system', icon: 'activity' },
  { name: 'Effitrac ERP', category: 'ERP', description: 'Business management', icon: 'database' },
  { name: 'Windows', category: 'OS', description: 'Desktop OS', slug: 'windows' },
  { name: 'Windows Server', category: 'OS', description: 'Server OS', slug: 'windows' },
  { name: 'Linux', category: 'OS', description: 'Open source OS', slug: 'linux' },
];
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
  {tools.map((tool) => (
    <div class="group relative bg-white/5 border border-white/10 rounded-2xl p-4 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 flex items-center gap-4">
      
      <!-- Icon Container -->
      <div class="w-12 h-12 shrink-0 rounded-xl bg-black/20 flex items-center justify-center p-2.5 group-hover:scale-110 transition-transform duration-300 overflow-hidden">
        {tool.imageUrl ? (
           <img 
            src={tool.imageUrl} 
            alt={tool.name}
            class="w-full h-full object-contain group-hover:opacity-100 transition-opacity"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
          />
        ) : tool.slug ? (
          <img 
            src={`https://cdn.simpleicons.org/${tool.slug}`} 
            alt={tool.name}
            class="w-full h-full object-contain opacity-80 group-hover:opacity-100 transition-opacity"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
          />
          <span class="hidden text-xs font-bold text-white/50">{tool.name.substring(0,2)}</span>
        ) : (
          /* Fallback Generic Icons (Lucide-style SVGs) */
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/70 group-hover:text-white transition-colors">
            {tool.icon === 'microsoft' && <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>}
            {tool.icon === 'windows' && <path d="M20 6.6L11 8V3H7v5L2 9.4 6 12l-4 2.6L7 16v5h4v-5l9 1.4z" />}
            {tool.icon === 'lock' && <><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></>}
            {tool.icon === 'user-cog' && <><path d="M19 21v-2a4 4 0 0 0-3-3.87"/><circle cx="12" cy="7" r="4"/><path d="M12 12h.01"/></>}
            {tool.icon === 'box' && <><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></>}
            {tool.icon === 'activity' && <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>}
            {tool.icon === 'database' && <><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></>}
            {!tool.icon && <circle cx="12" cy="12" r="10"/>}
          </svg>
        )}
      </div>

      <div class="flex-1 min-w-0">
        <h3 class="text-sm font-semibold text-white truncate group-hover:text-primary transition-colors">{tool.name}</h3>
        <p class="text-xs text-text-muted truncate">{tool.category}</p>
      </div>

      <!-- Hover Tooltip -->
      <div class="absolute opacity-0 group-hover:opacity-100 transition-opacity duration-300 inset-0 bg-surface/95 backdrop-blur-xl border border-primary/20 rounded-2xl p-4 flex items-center justify-center text-center z-10 pointer-events-none">
        <div>
          <p class="text-white font-medium text-sm mb-1">{tool.name}</p>
          <p class="text-text-muted text-xs leading-relaxed">{tool.description}</p>
        </div>
      </div>
    </div>
  ))}
</div>
