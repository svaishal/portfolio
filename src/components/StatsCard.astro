---
interface StatItem {
  value: string | number;
  label: string;
  valueClass?: string;
}

interface Props {
  stats: StatItem[];
  columns?: number;
}

const { stats, columns = 4 } = Astro.props;

const gridClass = columns === 2 ? 'grid-cols-2' : 
                 columns === 3 ? 'grid-cols-2 md:grid-cols-3' : 
                 'grid-cols-2 md:grid-cols-4';
---

<div class={`grid ${gridClass} gap-6`} data-animate>
  {stats.map((stat) => (
    <div class="glass-card p-6">
      <p class={stat.valueClass || "text-3xl font-bold text-white"}>{stat.value}</p>
      <p class="text-text-muted text-sm mt-2">{stat.label}</p>
    </div>
  ))}
</div>
