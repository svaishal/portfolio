---
interface Props {
  company: string;
  role: string;
  period: string;
  current: boolean;
  achievements: string[];
}

const { company, role, period, current, achievements } = Astro.props;
---

<article class="glass-card p-6 md:p-8 hover:border-primary/30 transition-all duration-300 group">
  {current && (
    <div class="absolute top-6 right-6 z-10">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
      </span>
    </div>
  )}

  <div class="relative z-10">
    <div class="mb-6">
      <h3 class="text-2xl font-bold text-white group-hover:text-primary transition-colors">{role}</h3>
      <p class="text-primary font-medium text-lg mt-1">{company}</p>
      <div class="flex items-center gap-3 mt-2">
        <span class="px-3 py-1 text-xs font-medium bg-white/5 text-text-muted rounded-full border border-white/10">
          {period}
        </span>
        {current && (
          <span class="px-3 py-1 text-xs font-medium bg-emerald-500/10 text-emerald-400 rounded-full border border-emerald-500/20">
            Current
          </span>
        )}
      </div>
    </div>

    <ul class="space-y-3">
      {achievements.map(achievement => (
        <li class="flex items-start gap-3 text-text-muted">
          <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-primary/50 shrink-0"></span>
          <span class="leading-relaxed font-light">{achievement}</span>
        </li>
      ))}
    </ul>
  </div>
</article>
