---
import { getSocialUrl, getInitials } from '../lib/data';
import type { PortfolioData } from '../lib/data';
import StatsCard from './StatsCard.astro';
import SkillsGrid from './SkillsGrid.astro';
import ExperienceCard from './ExperienceCard.astro';

interface Props {
  data: PortfolioData;
}

const { data } = Astro.props;
const profile = data.profile;

if (!profile) {
  throw new Error("Profile data is missing");
}

const githubUrl = getSocialUrl(data.socialLinks, 'github');
const linkedinUrl = getSocialUrl(data.socialLinks, 'linkedin');
---

  <!-- Hero Section -->
  <section class="min-h-screen flex items-center px-6 pt-28 pb-20 relative overflow-hidden">
    <!-- Animated Background Elements (Landa Style) - Toned down to prevent white wash -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-125 h-125 bg-blue-500/5 rounded-full blur-[100px] animate-pulse"></div>
      <div class="absolute bottom-1/4 right-1/4 w-100 h-100 bg-indigo-900/10 rounded-full blur-[80px] animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-200 h-200 bg-indigo-500/5 rounded-full blur-[120px]"></div>
    </div>

    <!-- Grid Pattern Removed -->


    <div class="relative z-10 max-w-6xl mx-auto w-full">
      <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
        <div class="text-left">
          <div class="opacity-0 animate-fade-in-up delay-100 flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-8 mb-10">
            <div class="relative group">
              <div class="w-40 h-40 sm:w-56 sm:h-56 rounded-3xl bg-white/5 border border-white/10 shadow-2xl overflow-hidden transition-all duration-500 group-hover:scale-[1.02] group-hover:border-white/20">
                {profile.profile_photo_url ? (
                  <img src={profile.profile_photo_url} alt={profile.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="eager" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-surface">
                    <span class="text-6xl font-bold text-transparent bg-clip-text bg-linear-to-br from-primary to-secondary">{getInitials(profile.name)}</span>
                  </div>
                )}
              </div>
            </div>
            
            <div class="flex flex-col justify-center h-full py-2">

            </div>
          </div>

          <h1 class="opacity-0 animate-fade-in-up delay-200 text-5xl sm:text-6xl lg:text-7xl font-bold mb-6 tracking-tight">
            <span class="text-primary">{profile.name}</span>
          </h1>

          <div class="opacity-0 animate-fade-in-up delay-300 mb-8">
            <p class="text-xl sm:text-2xl lg:text-3xl font-medium text-gradient inline-block">
              {profile.role}
            </p>
            <p class="text-text-muted text-base sm:text-lg mt-4 max-w-2xl leading-relaxed">
              {profile.subtitle}
            </p>
            {profile.open_to_work && (
              <div class="mt-4 inline-flex">
                 <span class="inline-flex items-center gap-2 text-xs text-emerald-300 border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 rounded-full">
                  <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                  </span>
                  Open to work
                </span>
              </div>
            )}
          </div>

          <div class="opacity-0 animate-fade-in-up delay-400 flex flex-wrap gap-4 mb-8">
            <div class="flex items-center gap-2 text-text-muted px-4 py-2 rounded-full bg-white/5 border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="text-sm font-medium">{profile.location}</span>
            </div>
            <div class="flex items-center gap-2 text-text-muted px-4 py-2 rounded-full bg-white/5 border border-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="text-sm font-medium">{profile.years_experience} Years</span>
            </div>
          </div>

          <p class="opacity-0 animate-fade-in-up delay-500 text-lg text-text-muted max-w-2xl mb-10 leading-relaxed font-light">
            {profile.tagline}
          </p>

          <div class="opacity-0 animate-fade-in-up delay-500 flex flex-col sm:flex-row gap-4 mb-10">
            <a href="/portfolio" class="btn-primary group">
              <span>View My Work</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="/contact" class="btn-secondary group">
              <span>Get in Touch</span>
            </a>
          </div>

          <div class="opacity-0 animate-fade-in-up delay-500 flex gap-3">
            {githubUrl && (
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-11 h-11 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-text-muted hover:text-white hover:border-white/30 hover:bg-white/10 transition-all duration-300"
                aria-label="GitHub"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            )}
            {linkedinUrl && (
              <a
                href={linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-11 h-11 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-text-muted hover:text-white hover:border-white/30 hover:bg-white/10 transition-all duration-300"
                aria-label="LinkedIn"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>
            )}
          </div>
        </div>

        <div class="space-y-6">
          <div class="glass-card p-8" data-animate>
            <p class="text-text-muted text-xs uppercase tracking-[0.35em]">Impact</p>
            <h3 class="text-2xl font-semibold text-white mt-4">Reliability, speed, and clear support</h3>
            <p class="text-text-muted mt-4 leading-relaxed">I focus on fast resolution, stable systems, and a calm customer experience in high-volume environments.</p>
          </div>

          <StatsCard 
            stats={[
              { value: `${profile.years_experience}+`, label: 'Years in support' },
              { value: data.certifications!.length, label: 'Certifications' },
              { value: data.experiences!.length, label: 'Roles' },
              { value: '99%+', label: 'Customer satisfaction' }
            ]}
            columns={2}
          />
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0 animate-fade-in delay-1000">
      <a href="#skills" class="flex flex-col items-center gap-2 text-text-muted hover:text-primary transition-colors">
        <span class="text-xs uppercase tracking-widest font-medium">Scroll</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Skills Preview Section -->
  <section id="skills" class="py-24 px-6 relative">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16" data-animate>
        <p class="section-title">What I Do</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-6">Core Expertise</h2>
        <p class="text-text-muted max-w-2xl mx-auto text-lg">Bridging the gap between technology and users with reliable support and clear communication.</p>
      </div>

      <!-- Skills Grid -->
      <SkillsGrid skills={data.technicalSkills} limit={8} />

      <!-- CTA -->
      <div class="text-center mt-12" data-animate>
        <a href="/experience" class="inline-flex items-center gap-2 text-secondary hover:text-primary transition-colors group">
          <span class="font-medium">View Full Experience</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="py-24 px-6 relative">
    <div class="max-w-6xl mx-auto">
      <StatsCard 
        stats={[
          { value: `${profile.years_experience}+`, label: 'Years Experience' },
          { value: data.experiences!.length, label: 'Roles' },
          { value: '95%+', label: 'Satisfaction Rate' },
          { value: data.certifications!.length, label: 'Certifications' }
        ]}
      />
    </div>
  </section>

  <!-- Featured Experience -->
  <section class="py-24 px-6 relative">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16" data-animate>
        <p class="section-title">Career Journey</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-4">My Path</h2>
      </div>

      <!-- Timeline Preview -->
      <div class="space-y-6" data-animate>
        {data.experiences!.slice(0, 3).map((exp, index: number) => (
          <ExperienceCard 
            company={exp.company}
            role={exp.role}
            period={exp.period}
            current={exp.is_current}
            achievements={exp.achievements}
          />
        ))}
      </div>

      <div class="text-center mt-12" data-animate>
        <a href="/experience" class="btn-secondary">
          <span>View Full Journey</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 px-6 relative">
    <div class="max-w-4xl mx-auto">
      <div class="glass-card p-10 sm:p-16 text-center relative overflow-hidden" data-animate>
        <!-- Background Glow -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-linear-to-b from-primary/10 to-transparent opacity-50 pointer-events-none"></div>
        
        <div class="relative z-10">
          <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-6">Let's Work Together</h2>
          <p class="text-text-muted mb-10 max-w-lg mx-auto text-lg leading-relaxed">
            Looking for a reliable IT professional who communicates clearly and delivers results? Let's connect.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="btn-primary">
              <span>Get in Touch</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            {linkedinUrl && (
              <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                <span>LinkedIn</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
