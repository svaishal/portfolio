---
interface Props {
  name: string;
  description: string;
  icon?: string;
}

const { name, description, icon = 'default' } = Astro.props;

// Icon URL mapping - using selfh.st/icons or fallback to text
const iconMap: Record<string, string> = {
  'logmein': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/logmein.svg',
  'anydesk': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/anydesk.svg',
  'citrix': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/citrix.svg',
  'uptime-kuma': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/uptime-kuma.svg',
  'docker': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/docker.svg',
  'proxmox': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/proxmox.svg',
  'virtualbox': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/virtualbox.svg',
  'microsoft': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/microsoft.svg',
  'okta': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/okta.svg',
  'windows': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/windows.svg',
  'specops': '',
  'quest': '',
  'tailscale': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/tailscale.svg',
  'openvpn': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/openvpn.svg',
  'paloalto': '',
  'sophos': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/sophos.svg',
  'github': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/github.svg',
  'vscode': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/vscode.svg',
  'cloudflare': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/cloudflare.svg',
  'brevo': '',
  'servicenow': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/servicenow.svg',
  'zendesk': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/zendesk.svg',
  'snipe-it': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/snipe-it.svg',
  'google': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/google.svg',
  'microsoft-365': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/microsoft-365.svg',
  'slack': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/slack.svg',
  'erp': '',
  'windows-server': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/windows.svg',
  'linux': 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/linux.svg',
};

const iconUrl = icon.startsWith('http') ? icon : (iconMap[icon] || '');
const hasIcon = iconUrl !== '';
---

<div 
  class="group relative flex items-center gap-3 p-3 bg-surface border border-white/5 rounded-xl hover:border-primary/50 hover:bg-white/5 transition-all cursor-default"
  tabindex="0"
  role="button"
  aria-describedby={`tooltip-${name.replace(/\s+/g, '-').toLowerCase()}`}
>
  {hasIcon ? (
    <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center shrink-0">
      <img 
        src={iconUrl} 
        alt="" 
        aria-hidden="true"
        class="w-5 h-5 opacity-70 group-hover:opacity-100 transition-opacity"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center shrink-0">
      <span class="text-xs font-bold text-text-muted group-hover:text-white transition-colors">
        {name.substring(0, 2).toUpperCase()}
      </span>
    </div>
  )}
  
  <span class="text-sm font-medium text-text-muted group-hover:text-white transition-colors truncate">
    {name}
  </span>
  
  <!-- Tooltip -->
  <div 
    id={`tooltip-${name.replace(/\s+/g, '-').toLowerCase()}`}
    role="tooltip"
    class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-3 bg-surface border border-white/10 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-20 pointer-events-none"
  >
    <div class="text-xs font-bold text-white mb-1">{name}</div>
    <div class="text-xs text-text-muted leading-relaxed">{description}</div>
    
    <!-- Arrow -->
    <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-surface"></div>
  </div>
</div>
