---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useProfileData } from '../hooks/useProfileData';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  // allow passing strict data to avoid waterfall if page already fetched it
  profileData?: any; 
}

const {
  title,
  description = "Technical Support Professional & IT Specialist",
  ogImage = "/images/og-default.png",
  profileData
} = Astro.props;

// Fetch data if not provided (for pages that don't satisfy the data requirement themselves)
const data = profileData || await useProfileData();
const profile = data?.profile;
const socialLinks = data?.socialLinks;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = `${title} | ${profile?.name || 'Portfolio'}`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{siteTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>
  <meta name="author" content={profile?.name || 'Vaishal S'}>
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#050505">

  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={siteTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(ogImage, Astro.site)}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={siteTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <style>
    /* Prevent FOUC */
    html { visibility: visible; opacity: 1; }
  </style>
</head>
<body class="bg-background text-text-main antialiased selection:bg-primary selection:text-white">
  
  <Header profile={profile} socialLinks={socialLinks} />
  
  <main class="flex-1 w-full max-w-(--max-width) mx-auto px-6 pt-[calc(var(--nav-height)+2rem)]">
    <slot />
  </main>
  
  <Footer profile={profile} socialLinks={socialLinks} />
  
  <script>
    // Enhanced scroll-triggered animations with IntersectionObserver
    (function() {
      // Respect reduced motion preference
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      
      if (prefersReducedMotion) {
        document.querySelectorAll('[data-animate]').forEach(el => {
          el.classList.add('animate-visible');
        });
        return;
      }
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const staggerIndex = parseInt(el.dataset.animateStagger || '0', 10);
            const delay = staggerIndex * 80; // 80ms stagger
            
            setTimeout(() => {
              el.classList.add('animate-visible');
            }, delay);
            
            observer.unobserve(el);
          }
        });
      }, { 
        threshold: 0.1, 
        rootMargin: '0px 0px -30px 0px' 
      });

      // Add stagger indices to sibling animated elements
      const processedParents = new Set();
      document.querySelectorAll('[data-animate]').forEach(el => {
        const parent = el.parentElement;
        if (parent && !processedParents.has(parent)) {
          const siblings = parent.querySelectorAll(':scope > [data-animate]');
          siblings.forEach((sibling, index) => {
            (sibling as HTMLElement).dataset.animateStagger = index.toString();
          });
          processedParents.add(parent);
        }
        observer.observe(el);
      });
    })();
  </script>
</body>
</html>
